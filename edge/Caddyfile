# Caddy : frontal HTTPS commun à la prod et au test (projet Compose « edge »).
#
# Chaque environnement de LMAPP est un projet Compose à part; son service app
# rejoint le réseau Docker « edge » sous un nom unique :
#   lmapp-prod-app  (projet lmapp, louis.ledeneigeur.com)
#   lmapp-test-app  (projet lmapp-test, test.ledeneigeur.com)
#
# Certificats Let's Encrypt par validation DNS Cloudflare : Caddy crée un
# enregistrement TXT temporaire _acme-challenge avec le jeton de edge/.env.
# Aucun port 80 nécessaire, et ça fonctionne même si le 443 est filtré par IP.
{
	# Autorité : Let's Encrypt (production), par défaut. Pour un essai sans
	# limites, ajouter : acme_ca https://acme-staging-v02.api.letsencrypt.org/directory

	# Le port 80 n'est pas publié : pas de redirection HTTP vers HTTPS.
	auto_https disable_redirects
	servers {
		# HTTP/3 (UDP) désactivé : seul le 443 TCP est publié.
		protocols h1 h2
	}
}

(commun) {
	# Journal d'accès (JSON, sortie standard, plafonné par Docker à 10 Mo x 3).
	# Caddy masque les témoins et les en-têtes d'authentification par défaut.
	log {
		output stdout
		format json
	}

	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
		# Vérifier la propagation du TXT auprès d'un résolveur public
		resolvers 1.1.1.1
	}
	encode zstd gzip

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
	}
}

louis.ledeneigeur.com {
	import commun
	reverse_proxy lmapp-prod-app:8000
}

test.ledeneigeur.com {
	import commun
	reverse_proxy lmapp-test-app:8000
}
