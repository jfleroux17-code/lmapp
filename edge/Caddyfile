# Caddy : frontal HTTPS commun à la prod et au test (projet Compose « edge »).
#
# Chaque environnement de LMAPP est un projet Compose à part; son service app
# rejoint le réseau Docker « edge » sous un nom unique :
#   lmapp-prod-app  (projet lmapp, louis.ledeneigeur.com)
#   lmapp-test-app  (projet lmapp-test, test.ledeneigeur.com)
#
# Certificats Let's Encrypt par validation DNS Cloudflare : Caddy crée un
# enregistrement TXT temporaire _acme-challenge avec le jeton de edge/.env.
# Aucun port 80 nécessaire, et ça fonctionne même si le 443 est filtré par IP.
{
	# Autorité : Let's Encrypt (production), par défaut. Pour un essai sans
	# limites, ajouter : acme_ca https://acme-staging-v02.api.letsencrypt.org/directory

	# Le port 80 n'est pas publié : pas de redirection HTTP vers HTTPS.
	auto_https disable_redirects
	servers {
		# HTTP/3 (UDP) désactivé : seul le 443 TCP est publié.
		protocols h1 h2
	}
}

(commun) {
	# Journal d'accès (JSON, sortie standard, plafonné par Docker à 10 Mo x 3).
	# Caddy masque les témoins et les en-têtes d'authentification par défaut.
	log {
		output stdout
		format json
	}

	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
		# Vérifier la propagation du TXT auprès d'un résolveur public
		resolvers 1.1.1.1
	}
	encode zstd gzip

	# Taille des envois plafonnée à 10 Mo (décision de JF, 8 novembre 2026) : la plus grosse requête
	# légitime est une photo de l'entrée (8 Mo au plus, environ 300 Ko une fois réduite).
	request_body {
		max_size 10MB
	}

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		# HSTS : le navigateur refuse ensuite le HTTP pour ce domaine pendant un an.
		# Pas de « preload » : ce serait très long à retirer.
		Strict-Transport-Security "max-age=31536000"
		# Audit de sécurité, point 6 (go de JF, 13 novembre 2026). Permissions : caméra et position pour l'app
		# seulement, micro jamais. CSP d'abord en « rapport seulement » (rapports à /csp-rapport/, journal de l'app);
		# Alpine.js exige 'unsafe-eval', et les pages ont de petits scripts et styles intégrés ('unsafe-inline').
		Permissions-Policy "camera=(self), geolocation=(self), microphone=(), payment=(), usb=()"
		Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://tile.openstreetmap.org; connect-src 'self'; font-src 'self'; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; report-uri /csp-rapport/"
	}

	# Administration réservée aux IP de JF (LMAPP_IPS_ADMIN dans edge/.env, hors Git).
	# Variable vide ou absente : /admin/ refusé à tout le monde (sécuritaire).
	# Lu au démarrage : après un changement des IP, recréer Caddy (docker compose up -d).
	@admin_interdit {
		path /admin /admin/*
		not remote_ip {$LMAPP_IPS_ADMIN}
	}
	respond @admin_interdit "Accès refusé." 403
}

louis.ledeneigeur.com {
	import commun
	reverse_proxy lmapp-prod-app:8000
}

# Test réservé aux IP de JF (même liste que /admin/), exception à la règle « filtrage au routeur seulement »
# acceptée par JF le 8 novembre 2026 : personne d'autre que lui n'a affaire au test.
test.ledeneigeur.com {
	import commun
	@pas_jf not remote_ip {$LMAPP_IPS_ADMIN}
	respond @pas_jf "Accès refusé." 403
	reverse_proxy lmapp-test-app:8000
}

# Administration à une adresse neutre (PRD Q6), sans nom de déneigeur. Rien d'autre n'y répond.
# La prod a LMAPP_HOTE_ADMIN=admin.ledeneigeur.com : /admin/ ne répond plus que sur ce nom.
# La restriction aux IP de JF (import commun) s'applique ici aussi.
admin.ledeneigeur.com {
	import commun
	@hors_admin not path /admin /admin/* /static/*
	respond @hors_admin "Introuvable." 404
	reverse_proxy lmapp-prod-app:8000
}
