# Modèle de /srv/lmapp/test/.env (environnement de TEST). Copier en .env (permissions 600) et remplir.
# Ce fichier-ci est suivi par Git : n'y mettre AUCUNE vraie valeur.

# Environnement : prod ou test (garde-fous sur les envois réels)
LMAPP_ENV=test
# Nom de domaine de cet environnement (référence; Caddy est configuré dans edge/Caddyfile)
LMAPP_DOMAINE=test.ledeneigeur.com

# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
# localhost : nécessaire à la vérification de santé de Docker
DJANGO_ALLOWED_HOSTS=test.ledeneigeur.com,localhost

# PostgreSQL (réseau Docker interne, jamais publié)
POSTGRES_DB=lmapp_test
POSTGRES_USER=lmapp_test
POSTGRES_PASSWORD=
POSTGRES_HOST=db

# En test : textos et courriels vers JF seulement.
# Plus tard (à remplir par JF directement sur ld1, jamais dans le clavardage) :
# SMTP2GO_API_KEY=
# IMAP_HOTE=
# IMAP_UTILISATEUR=
# IMAP_MOT_DE_PASSE=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
