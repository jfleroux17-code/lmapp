# Modèle de /srv/lmapp/.env. Copier en .env (permissions 600) et remplir.
# Ce fichier-ci est suivi par Git : n'y mettre AUCUNE vraie valeur.

# Environnement : prod ou test (garde-fous sur les envois réels)
LMAPP_ENV=prod
# Nom de domaine de cet environnement (référence; Caddy est configuré dans edge/Caddyfile)
LMAPP_DOMAINE=louis.ledeneigeur.com

# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
# localhost : nécessaire à la vérification de santé de Docker
DJANGO_ALLOWED_HOSTS=louis.ledeneigeur.com,localhost

# PostgreSQL (réseau Docker interne, jamais publié)
POSTGRES_DB=lmapp
POSTGRES_USER=lmapp
POSTGRES_PASSWORD=
POSTGRES_HOST=db

# Proxy de confiance : l'IP fixe de Caddy sur le réseau Docker edge
# (edge/compose.yaml). Seules ses requêtes peuvent donner l'IP réelle du visiteur.
LMAPP_PROXIES_DE_CONFIANCE=172.20.0.250
FORWARDED_ALLOW_IPS=172.20.0.250

# Hors prod : seuls destinataires permis d'un envoi réel (cellulaires +1XXXXXXXXXX et courriels de JF),
# séparés par des virgules. Vide : aucun envoi réel possible en test.
# LMAPP_DESTINATAIRES_TEST=

# Limitation des essais de connexion (facultatif, valeurs par défaut) :
# échecs permis par IP et par nom d'utilisateur dans la fenêtre, en minutes
# LMAPP_CONNEXION_MAX_IP=10
# LMAPP_CONNEXION_MAX_COMPTE=20
# LMAPP_CONNEXION_FENETRE_MIN=15

# Plus tard (à remplir par JF directement sur ld1, jamais dans le clavardage) :
# SMTP2GO_API_KEY=
# IMAP_HOTE=
# IMAP_UTILISATEUR=
# IMAP_MOT_DE_PASSE=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# (le numéro d'envoi est dans la fiche de l'entreprise, « numéro de texto d'affaires »;
#  les envois réels s'allument dans la fiche aussi, « envois réels activés »)

# Administration à une adresse neutre (PRD Q6), au 2e déneigeur. Vide : /admin/ sur tous les domaines.
# LMAPP_HOTE_ADMIN=admin.ledeneigeur.com
# Suivi de livraison des textos, quand Twilio peut joindre ld1 :
# TWILIO_URL_STATUT=https://louis.ledeneigeur.com/webhooks/twilio/statut/
